{
  "name": "wuwa-gacha-simulator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "SINGLE_FILE=1 vite build && node scripts/build-single-html.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke-combat.mjs",
    "check:balance": "node scripts/check-balance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vitest run tests/lint/",
    "lint:strict": "node scripts/run-lint-strict.mjs",
    "typecheck": "tsc --noEmit",
    "push": "node scripts/push.mjs",
    "preview:char": "node scripts/preview-char.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@preact/signals": "^2.9.2",
    "preact": "^10.29.3"
  }
}
